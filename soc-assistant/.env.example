# Copy this file to backend/.env and fill in values as needed.
# Nothing here is required to run the project -- sensible defaults/fallbacks exist.

SECRET_KEY=change-me
FLASK_DEBUG=1
HOST=0.0.0.0
PORT=5000

DB_PATH=data/soc_assistant.db

# ---- Wazuh (optional; simulator is used automatically if empty) ----
WAZUH_API_URL=https://your-wazuh-manager:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=your-password
WAZUH_VERIFY_SSL=0

# ---- LLM provider: none | anthropic | openai ----
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

SIGMA_RULES_DIR=data/sigma_rules
MITRE_DATA_PATH=data/mitre_attack.json
